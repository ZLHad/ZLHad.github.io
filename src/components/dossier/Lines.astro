---
// Direct-labelled line chart, drawn at build time. No legend: the label sits on the line.
interface Series { name: string; values: number[]; hi?: boolean; dy?: number }
interface Props {
  title: string;
  x: number[];
  xLabel: string;
  yLabel: string;
  series: Series[];
  yMin: number;
  yMax: number;
  yTicks: number[];
  source?: string;
}
const { title, x, xLabel, yLabel, series, yMin, yMax, yTicks, source } = Astro.props;
const W = 720, H = 316, L = 46, R = 150, T = 30, B = 40;
const sx = (v: number) => L + ((v - x[0]) / (x[x.length - 1] - x[0])) * (W - L - R);
const sy = (v: number) => T + (1 - (v - yMin) / (yMax - yMin)) * (H - T - B);
const path = (vals: number[]) => vals.map((v, i) => `${i ? 'L' : 'M'}${sx(x[i]).toFixed(1)} ${sy(v).toFixed(1)}`).join('');
---
<figure class="lines card" data-reveal>
  <figcaption class="t">{title}</figcaption>
  <div class="scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title}>
      {yTicks.map((t) => (
        <g>
          <line x1={L} x2={W - R} y1={sy(t)} y2={sy(t)} class="grid" />
          <text x={L - 8} y={sy(t) + 4} text-anchor="end" class="tick">{t}</text>
        </g>
      ))}
      {x.map((v) => <text x={sx(v)} y={H - B + 18} text-anchor="middle" class="tick">{v}</text>)}
      <text x={(L + W - R) / 2} y={H - 4} text-anchor="middle" class="axis">{xLabel}</text>
      <text x={L - 38} y="12" class="axis">{yLabel}</text>
      {series.map((s) => (
        <g class:list={['series', { hi: s.hi }]}>
          <path d={path(s.values)} class="line" pathLength="1" />
          {s.values.map((v, i) => (
            <circle cx={sx(x[i])} cy={sy(v)} r={s.hi ? 3 : 2} class="pt" />
          ))}
          {s.values.map((v, i) => (
            <circle cx={sx(x[i])} cy={sy(v)} r="9" class="hit" data-tip-head={s.name} data-tip={`${xLabel} ${x[i]}: ${yLabel} ${v}`} />
          ))}
          <text x={sx(x[x.length - 1]) + 8} y={sy(s.values[s.values.length - 1]) + 4 + (s.dy ?? 0)} class="name">{s.name}</text>
        </g>
      ))}
    </svg>
  </div>
  {source && <p class="src label">{source}</p>}
</figure>

<style>
  .lines { margin: 2em 0; padding: 16px 18px 14px; }
  .t { font-size: var(--t-small); font-weight: 500; line-height: 1.35; margin-bottom: 8px; color: var(--fg); }
  .scroll { overflow-x: auto; }
  svg { width: 100%; min-width: 640px; height: auto; display: block; overflow: visible; }
  .grid { stroke: var(--line-2); }
  .tick, .axis, .name { font-size: 14.8px; fill: var(--fg-3); }
  .tick { font-family: var(--f-mono); letter-spacing: -0.02em; }
  .axis, .name { font-family: var(--f-sans); }
  .line { fill: none; stroke: rgba(190, 205, 225, 0.38); stroke-width: 1.25; stroke-linejoin: round; stroke-linecap: round; }
  :global(.js) .lines .line { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.5s var(--ease-in-out) 0.2s, stroke var(--d-1); }
  :global(.js) .lines:global(.in) .line { stroke-dashoffset: 0; }
  :global(.js) .lines .pt { opacity: 0; transition: opacity 0.5s 1.1s; }
  :global(.js) .lines:global(.in) .pt { opacity: 1; }
  .pt { fill: rgba(190, 205, 225, 0.5); }
  .hit { fill: transparent; }
  .name { fill: var(--fg-2); transition: fill var(--d-1); }
  .hi .line { stroke: var(--signal); stroke-width: 2.25; }
  .hi .pt { fill: var(--signal); }
  .hi .name { fill: var(--signal-2); }
  .series:hover .line { stroke: var(--fg); }
  .series.hi:hover .line { stroke: var(--signal-2); }
  .series:hover .name { fill: var(--fg); }
  .src { margin-top: 8px; }
</style>
