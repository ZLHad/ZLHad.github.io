---
// The full list: every paper with its figure, grouped the way the CV is. Filter, search
// and the figure wall all work without a reload; with JS off every entry is simply shown.
import Icon from '~/components/chrome/Icon.astro';
import PaperThumb from '~/components/papers/PaperThumb.astro';
import PaperMeta from '~/components/papers/PaperMeta.astro';
import { paperHref, ui, type Lang } from '~/lib/i18n';
import {
  allPapers,
  authorsOf,
  isFirstAuthor,
  isMe,
  linkLabel,
  paperLink,
  publishedOrder,
  titleOf,
  venueOf,
  type Paper,
} from '~/lib/papers';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = ui(lang);
const zh = lang === 'zh';
const papers = await allPapers();
const pub = publishedOrder(papers);
const groups = [
  { key: 'first', title: zh ? '第一作者，已发表' : 'First author, published', items: [...pub.filter(isFirstAuthor)] },
  { key: 'preprint', title: zh ? '预印本' : 'Preprints', items: papers.filter((p) => p.data.status === 'preprint') },
  { key: 'co', title: zh ? '合作论文，已发表' : 'Co-authored, published', items: pub.filter((p) => !isFirstAuthor(p)) },
];
const isJournal = (p: Paper) => ['journal', 'magazine', 'letter', 'correspondence'].includes(p.data.kind);
const isConf = (p: Paper) => p.data.kind === 'conference';
const filters = [
  { key: 'all', label: s.all, n: papers.length },
  { key: 'first', label: s.firstAuthor, n: papers.filter(isFirstAuthor).length },
  { key: 'journal', label: s.journals, n: papers.filter(isJournal).length },
  { key: 'conference', label: s.conferences, n: papers.filter(isConf).length },
];
const tags = (p: Paper) =>
  [isFirstAuthor(p) && 'first', isJournal(p) && 'journal', isConf(p) && 'conference'].filter(Boolean).join(' ');
const searchText = (p: Paper) => `${titleOf(p, lang)} ${p.data.title} ${authorsOf(p, lang).join(' ')} ${p.data.authors.join(' ')} ${venueOf(p, lang)} ${p.data.venue} ${p.data.venueShort} ${p.data.year}`.toLowerCase();
---
<div class="publist" data-publist data-view="list">
  <div class="tools" data-tools>
    <div class="filters" role="group" aria-label={zh ? '筛选论文' : 'Filter publications'} data-seg>
      <span class="thumb-seg" data-seg-thumb aria-hidden="true"></span>
      {filters.map((f, i) => (
        <button type="button" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
          {f.label}<span class="num">{f.n}</span>
        </button>
      ))}
    </div>
    <div class="right">
      <label class="find" data-js-only>
        <Icon name="search" />
        <input type="search" data-find placeholder={zh ? '题目、作者、期刊' : 'Title, author, venue'} aria-label={zh ? '搜索论文' : 'Search papers'} />
      </label>
      <div class="views" role="group" aria-label={zh ? '显示方式' : 'View'} data-js-only>
        <button type="button" data-view-set="list" aria-pressed="true" title={zh ? '列表' : 'List'} aria-label={zh ? '列表' : 'List'}><Icon name="list" /></button>
        <button type="button" data-view-set="wall" aria-pressed="false" title={zh ? '图墙' : 'Figure wall'} aria-label={zh ? '图墙' : 'Figure wall'}><Icon name="grid" /></button>
      </div>
      <a class="btn bib" href="/publications.bib" download><Icon name="download" />BibTeX</a>
    </div>
  </div>
  <p class="none" data-none hidden>{zh ? '没有符合条件的论文。' : 'No papers match.'}</p>
  <div class="groups">
  {groups.map((g) => g.items.length > 0 && (
    <section class="group" data-group={g.key}>
      <h2 class="group-title"><span>{g.title}</span><span class="count num">{g.items.length}</span></h2>
      <ol class="rows">
        {g.items.map((p, i) => {
          const to = paperHref(lang, p.id);
          const link = paperLink(p);
          return (
            <li class="row spot has-thumb" data-spot data-tags={tags(p)} data-search={searchText(p)} data-paper-row={p.id} data-row-name={`row-${p.id}`} data-reveal style={`--i:${Math.min(i, 5)}`}>
              <a class="thumb" href={to} data-open-paper={p.id} tabindex="-1" aria-hidden="true">
                <PaperThumb paper={p} lang={lang} />
              </a>
              <div class="main">
                <p class="meta"><PaperMeta paper={p} lang={lang} month /></p>
                <h3 class="title" lang={zh && !p.data.titleZh ? 'en' : undefined}><a href={to} data-open-paper={p.id}>{titleOf(p, lang)}</a></h3>
                <p class="authors">
                  {authorsOf(p, lang).map((a, n) => (
                    <Fragment>{n > 0 && (zh && p.data.authorsZh ? '，' : ', ')}{isMe(a) ? <b>{a}</b> : a}</Fragment>
                  ))}
                </p>
                <p class="where">{venueOf(p, lang)}{p.data.volume && `, vol. ${p.data.volume}`}{p.data.number && `, no. ${p.data.number}`}{p.data.pages && `, pp. ${p.data.pages.replace('-', '–')}`}</p>
                <p class="acts">
                  <a class="act" href={to} data-open-paper={p.id}>{s.overview}<Icon name="expand" size={14} /></a>
                  {link && <a class="act" href={link} target="_blank" rel="noopener">{linkLabel(p, lang)}<Icon name="go" size={14} /></a>}
                  {p.data.links?.code && <a class="act" href={p.data.links.code} target="_blank" rel="noopener">{s.code}<Icon name="go" size={14} /></a>}
                  {p.data.dossier && <a class="act" href={`${to}#deep-dive`}>{s.deepDive}<Icon name="next" size={14} /></a>}
                </p>
              </div>
            </li>
          );
        })}
      </ol>
    </section>
  ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-publist]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const rows = [...root.querySelectorAll<HTMLElement>('.row')];
    const groups = [...root.querySelectorAll<HTMLElement>('[data-group]')];
    const find = root.querySelector<HTMLInputElement>('[data-find]')!;
    const none = root.querySelector<HTMLElement>('[data-none]')!;
    const seg = root.querySelector<HTMLElement>('[data-seg]')!;
    const thumb = root.querySelector<HTMLElement>('[data-seg-thumb]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let key = 'all';

    const moveThumb = () => {
      const on = buttons.find((b) => b.getAttribute('aria-pressed') === 'true')!;
      thumb.style.width = `${on.offsetWidth}px`;
      thumb.style.transform = `translateX(${on.offsetLeft}px)`;
    };
    moveThumb();
    new ResizeObserver(moveThumb).observe(seg);

    // The list rearranges itself: every row moves from where it was to where it lands.
    const animate = (change: () => void) => {
      if (reduced || !document.startViewTransition) return change();
      const seen = rows.filter((r) => !r.hidden);
      const inView = (r: HTMLElement) => {
        const b = r.getBoundingClientRect();
        return b.bottom > -200 && b.top < innerHeight + 200;
      };
      seen.filter(inView).forEach((r) => {
        r.style.viewTransitionName = r.dataset.rowName!;
        r.style.setProperty('view-transition-class', 'row-move');
      });
      const vt = document.startViewTransition(() => {
        rows.forEach((r) => (r.style.viewTransitionName = ''));
        change();
        rows.filter((r) => !r.hidden && inView(r)).forEach((r) => {
          r.classList.add('in');
          r.style.viewTransitionName = r.dataset.rowName!;
          r.style.setProperty('view-transition-class', 'row-move');
        });
      });
      vt.ready.catch(() => {});
      vt.finished.catch(() => {}).finally(() => rows.forEach((r) => (r.style.viewTransitionName = '')));
    };

    const apply = () => {
      const words = find.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
      rows.forEach((r) => {
        const hay = r.dataset.search!;
        r.hidden = (key !== 'all' && !r.dataset.tags!.split(' ').includes(key)) || !words.every((w) => hay.includes(w));
        r.classList.add('in');
      });
      groups.forEach((g) => (g.hidden = !g.querySelector('.row:not([hidden])')));
      none.hidden = rows.some((r) => !r.hidden);
    };

    // A shorter list should not leave the reader looking at the footer.
    const keepListInView = () => {
      const bar = document.querySelector<HTMLElement>('[data-topbar]')?.offsetHeight ?? 0;
      const top = root.getBoundingClientRect().top + scrollY - bar;
      if (scrollY > top) scrollTo({ top, behavior: 'instant' });
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        key = b.dataset.filter!;
        moveThumb();
        animate(() => {
          apply();
          keepListInView();
        });
      }),
    );
    find.addEventListener('input', apply);

    const viewButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-view-set]')];
    const setView = (v: string, save = true) => {
      root.dataset.view = v;
      viewButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.viewSet === v)));
      rows.forEach((r) => r.classList.add('in'));
      if (save) {
        try {
          localStorage.setItem('pub-view', v);
        } catch {}
      }
    };
    viewButtons.forEach((b) =>
      b.addEventListener('click', () =>
        animate(() => {
          setView(b.dataset.viewSet!);
          keepListInView();
        }),
      ),
    );
    try {
      const saved = localStorage.getItem('pub-view');
      if (saved === 'wall') setView('wall', false);
    } catch {}
  });
</script>

<style>
  /* The tools stay under the bar while the list scrolls. */
  .tools {
    position: sticky;
    top: var(--bar);
    z-index: 20;
    view-transition-name: pub-tools;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
    margin-inline: calc(-1 * clamp(0px, 1vw, 12px));
    padding: 10px clamp(0px, 1vw, 12px);
    background: rgba(7, 9, 13, 0.82);
    backdrop-filter: blur(16px) saturate(1.4);
    box-shadow: 0 1px 0 var(--line-2);
  }
  .filters { position: relative; display: inline-flex; flex-wrap: wrap; gap: 2px; padding: 3px; border-radius: 11px; background: rgba(190, 205, 225, 0.05); box-shadow: inset 0 0 0 1px var(--line-2); }
  .filters button { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 7px; height: 30px; padding: 0 11px; font-size: var(--t-small); font-weight: 500; color: var(--fg-3); border-radius: 8px; transition: color var(--d-1); }
  .filters button .num { font-size: var(--t-label); font-weight: 400; color: var(--fg-3); }
  .filters button:hover { color: var(--fg); }
  .filters button[aria-pressed='true'] { color: var(--fg); }
  .filters button[aria-pressed='true'] .num { color: var(--signal-2); }
  .thumb-seg { display: none; position: absolute; left: 0; top: 3px; height: 30px; border-radius: 8px; background: rgba(190, 205, 225, 0.13); box-shadow: inset 0 0 0 1px var(--line), inset 0 1px 0 rgba(255, 255, 255, 0.05); transition: transform 0.4s var(--ease-out), width 0.4s var(--ease-out); }
  :global(.js) .thumb-seg { display: block; }
  :global(html:not(.js)) .filters { display: none; }
  .right { display: flex; align-items: center; gap: 8px; }
  [data-js-only] { display: none; }
  :global(.js) .find { display: inline-flex; }
  :global(.js) .views { display: inline-flex; }
  .find { align-items: center; gap: 8px; height: 36px; width: 214px; padding: 0 10px; color: var(--fg-3); border-radius: 10px; background: rgba(190, 205, 225, 0.05); box-shadow: inset 0 0 0 1px var(--line-2); transition: box-shadow var(--d-1), width var(--d-2) var(--ease-out); }
  .find:focus-within { box-shadow: inset 0 0 0 1px var(--line-3); color: var(--fg); }
  .find input { flex: 1; min-width: 0; height: 100%; font: inherit; font-size: var(--t-small); color: var(--fg); background: none; border: 0; outline: 0; }
  .find input::placeholder { color: var(--fg-3); }
  .find input::-webkit-search-cancel-button { display: none; }
  .views { gap: 2px; padding: 3px; border-radius: 10px; background: rgba(190, 205, 225, 0.05); box-shadow: inset 0 0 0 1px var(--line-2); }
  .views button { display: flex; align-items: center; justify-content: center; width: 30px; height: 28px; color: var(--fg-3); border-radius: 7px; transition: color var(--d-1), background var(--d-1); }
  .views button:hover { color: var(--fg); }
  .views button[aria-pressed='true'] { color: var(--fg); background: rgba(190, 205, 225, 0.13); }
  .none { margin-top: 48px; text-align: center; color: var(--fg-3); }
  .none[hidden] { display: none; }

  .group { margin-top: clamp(30px, 5vh, 52px); }
  .group:first-child { margin-top: 22px; }
  .group[hidden] { display: none; }
  .group-title { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding-bottom: 10px; font-family: var(--f-mono); font-size: var(--t-label); font-weight: 450; line-height: 1.4; color: var(--fg-2); box-shadow: 0 1px 0 var(--line); }
  .count { color: var(--fg-3); }

  /* While the pointer is on one row, the others step back. */
  .row {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: clamp(16px, 2.2vw, 32px);
    margin-inline: -12px;
    padding: 14px 12px;
    border-radius: var(--r-3);
    --thumb-pad: 10px;
    transition: opacity var(--d-2), background var(--d-2);
  }
  .row[hidden] { display: none; }
  .row:not(:last-child) { margin-bottom: 1px; }
  @media (hover: hover) {
    .publist:has(.row:hover) .row:not(:hover) { opacity: 0.5; }
    .row:hover { background: rgba(190, 205, 225, 0.03); }
  }
  .thumb { display: block; align-self: start; }
  .main { min-width: 0; align-self: center; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 12px; }
  .title { margin-top: 7px; font-size: var(--t-title); font-weight: 500; line-height: 1.28; letter-spacing: -0.016em; text-wrap: pretty; }
  .title:lang(zh) { line-height: 1.45; letter-spacing: 0; }
  .title a { text-decoration: none; }
  .title a:hover { color: inherit; }
  .row:hover .title { color: #fff; }
  .authors { margin-top: 6px; font-size: var(--t-small); line-height: 1.45; color: var(--fg-3); }
  .authors b { color: var(--fg); font-weight: 500; }
  .where { margin-top: 1px; font-size: var(--t-small); line-height: 1.45; color: var(--fg-3); }
  .acts { display: flex; flex-wrap: wrap; gap: 2px 14px; margin-top: 9px; }
  .act { position: relative; z-index: 4; display: inline-flex; align-items: center; gap: 4px; font-size: var(--t-small); font-weight: 500; color: var(--fg-2); text-decoration: none; }
  .act:hover { color: var(--signal-2); }
  .act :global(.icon) { color: var(--fg-3); transition: transform var(--d-2) var(--ease-out), color var(--d-1); }
  .act:hover :global(.icon) { color: inherit; }
  .act:hover :global(.icon-go) { transform: translate(1.5px, -1.5px); }
  .act:hover :global(.icon-next) { transform: translateX(2px); }

  /* The figure wall: one continuous grid, nothing but the work. */
  [data-view='wall'] .groups { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 14px; }
  [data-view='wall'] .group:not([hidden]), [data-view='wall'] .rows { display: contents; }
  [data-view='wall'] .group-title { display: none; }
  [data-view='wall'] .row:not([hidden]) { display: flex; flex-direction: column; gap: 0; margin: 0; padding: 0; overflow: hidden; background: linear-gradient(180deg, rgba(190, 205, 225, 0.045), rgba(190, 205, 225, 0.015)); box-shadow: inset 0 0 0 1px var(--line-2); --thumb-ar: 16 / 9.6; --thumb-pad: 14px; }
  [data-view='wall'] .thumb { align-self: stretch; }
  [data-view='wall'] .thumb :global(.plate), [data-view='wall'] .thumb :global(.ptile) { border-radius: 0; box-shadow: none; }
  [data-view='wall'] .main { flex: 1; align-self: stretch; padding: 12px 14px 14px; }
  [data-view='wall'] .title { font-size: 1rem; line-height: 1.34; }
  [data-view='wall'] .authors, [data-view='wall'] .where, [data-view='wall'] .acts { display: none; }
  @media (max-width: 999px) {
    [data-view='wall'] .groups { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .row { grid-template-columns: 240px minmax(0, 1fr); }
  }
  @media (max-width: 760px) {
    .tools { position: static; margin-inline: 0; padding-inline: 0; background: none; backdrop-filter: none; }
    .filters { order: 2; }
    .right { width: 100%; }
    .find { flex: 1; width: auto; min-width: 0; }
    .row { grid-template-columns: 124px minmax(0, 1fr); --thumb-pad: 5px; gap: 12px; }
    .where { display: none; }
    .title { font-size: 1.0625rem; margin-top: 5px; }
    .acts { gap: 2px 10px; }
    [data-view='wall'] .groups { grid-template-columns: minmax(0, 1fr); }
  }
</style>
