---
// The figure inspector: scroll or pinch to zoom, drag to pan, double-click to fit.
// Dense system diagrams are the reason this exists; they stay legible at any size here.
import Icon from '~/components/chrome/Icon.astro';
import { ui, type Lang } from '~/lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const zh = lang === 'zh';
const s = ui(lang);
---
<dialog id="zoom-dialog" aria-label={zh ? '放大查看' : 'Enlarged view'}>
  <div class="zm-canvas" data-zm-canvas>
    <div class="zm-sheet" data-zm-sheet><img alt="" draggable="false" /></div>
  </div>
  <div class="zm-bar">
    <p class="zm-cap" data-zm-cap></p>
    <div class="zm-tools">
      <span class="zm-zoom" role="group" aria-label={zh ? '缩放' : 'Zoom'}>
        <button type="button" data-zm="out" aria-label={zh ? '缩小' : 'Zoom out'}><Icon name="minus" /></button>
        <output class="num" data-zm-level>100%</output>
        <button type="button" data-zm="in" aria-label={zh ? '放大' : 'Zoom in'}><Icon name="plus" /></button>
        <button type="button" data-zm="fit" aria-label={zh ? '适应窗口' : 'Fit to window'} title={zh ? '适应窗口（双击）' : 'Fit (double-click)'}><Icon name="fit" /></button>
      </span>
      <button type="button" class="zm-close" data-zm="close" aria-label={s.close} title={zh ? '关闭（Esc）' : 'Close (Esc)'}><Icon name="close" /></button>
    </div>
  </div>
</dialog>

<style is:global>
  #zoom-dialog {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }
  #zoom-dialog[open] { display: flex; flex-direction: column; animation: zm-in 0.3s var(--ease-out); }
  #zoom-dialog::backdrop { background: rgba(4, 6, 9, 0.94); }
  @keyframes zm-in { from { opacity: 0; } }
  .zm-canvas { position: relative; flex: 1; min-height: 0; overflow: hidden; cursor: grab; touch-action: none; }
  .zm-canvas.grabbing { cursor: grabbing; }
  .zm-sheet {
    position: absolute;
    left: 0;
    top: 0;
    width: auto;
    overflow: hidden;
    background: #fff;
    border-radius: var(--r-1);
    box-shadow: 0 0 0 1px var(--line), 0 40px 120px -30px rgba(0, 0, 0, 0.8);
    transform-origin: 0 0;
    will-change: transform;
  }
  .zm-sheet img { display: block; max-width: none; max-height: none; pointer-events: none; }
  .zm-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 10px clamp(14px, 2vw, 24px);
    background: rgba(12, 15, 20, 0.86);
    box-shadow: 0 -1px 0 var(--line-2);
  }
  .zm-cap { min-width: 0; font-size: var(--t-small); line-height: 1.4; color: var(--fg-2); text-wrap: pretty; }
  .zm-tools { display: flex; flex: none; align-items: center; gap: 8px; }
  .zm-zoom { display: inline-flex; align-items: center; gap: 2px; padding: 2px; border-radius: 8px; background: rgba(190, 205, 225, 0.06); box-shadow: inset 0 0 0 1px var(--line-2); }
  .zm-zoom button, .zm-close { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 24px; color: var(--fg-2); border-radius: 6px; transition: color var(--d-1), background var(--d-1); }
  .zm-zoom button:hover, .zm-close:hover { color: var(--fg); background: rgba(190, 205, 225, 0.12); }
  .zm-zoom output { width: 46px; text-align: center; font-size: var(--t-label); color: var(--fg-2); }
  .zm-close { width: 32px; height: 30px; box-shadow: inset 0 0 0 1px var(--line-2); border-radius: 8px; }
  @media (max-width: 760px) {
    .zm-bar { flex-direction: column; align-items: stretch; gap: 8px; }
    .zm-tools { justify-content: space-between; }
  }
</style>
