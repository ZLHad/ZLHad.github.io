---
import { href, ui, type Lang } from '~/lib/i18n';
import { profile } from '~/data/profile';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = ui(lang);
const zh = lang === 'zh';
const built = new Date().toISOString().slice(0, 10);
const extra = [
  { k: 'Google Scholar', v: profile.links.scholar },
  { k: 'ORCID', v: profile.links.orcid },
  { k: 'IEEE Xplore', v: profile.links.ieee },
].filter((l) => l.v);
---
<footer class="footer" data-theme="core">
  <div class="frame inner">
    <section>
      <p class="eyebrow">{zh ? '联系' : 'Contact'}</p>
      <ul>
        <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
        <li><a href={`mailto:${profile.emailNus}`}>{profile.emailNus}</a></li>
        <li><a href={profile.links.github}>github.com/ZLHad</a></li>
        {extra.map((l) => <li><a href={l.v}>{l.k}</a></li>)}
      </ul>
    </section>
    <section>
      <p class="eyebrow">{zh ? '页面' : 'Pages'}</p>
      <ul>
        <li><a href={href(lang, '/publications/')}>{s.publications}</a></li>
        <li><a href={href(lang, '/research/')}>{s.research}</a></li>
        <li><a href={href(lang, '/projects/')}>{s.projects}</a></li>
        <li><a href={href(lang, '/cv/')}>{s.cv}</a></li>
      </ul>
    </section>
    <section class="about">
      <p class="eyebrow">{zh ? '关于本站' : 'About this site'}</p>
      <p class="text">{zh ? '纯静态，没有 Cookie 和统计脚本。首页和研究页的天空是实时渲染的大气，卫星和星间链路是一个模拟的低轨壳层。首页卡片上的论文图反相成了深色线稿，其他地方都是论文原图。' : 'Fully static, with no cookies or analytics. The sky on the home and research pages is a live atmosphere render, and the satellites and their links are a simulated LEO shell. Figures on the home page’s cards are inverted into dark line art; everywhere else they are as printed.'}</p>
      <p class="text faint">{zh ? '© IEEE。论文图片仅供个人使用，其他用途需获得 IEEE 许可。' : '© IEEE. Figures from papers are shown for personal use; any other use requires permission from IEEE.'}</p>
      <p class="text faint num">{zh ? '更新于' : 'Updated'} {built}</p>
    </section>
  </div>
  <p class="wordmark" aria-hidden="true">{zh ? profile.name.zh : profile.name.en}</p>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: 0;
    overflow: hidden;
    color: var(--fg);
    background: var(--bg);
    box-shadow: inset 0 1px 0 var(--line-2);
    padding-top: clamp(40px, 7vh, 72px);
  }
  /* The heat at the bottom of the section. */
  .footer::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -360px;
    width: min(1500px, 140vw);
    height: 560px;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgba(255, 122, 51, 0.3), rgba(255, 122, 51, 0.07) 55%, transparent);
    pointer-events: none;
  }
  .inner { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  ul { margin-top: 12px; font-size: var(--t-small); }
  li { margin-top: 6px; color: var(--fg-2); }
  a { text-decoration: none; }
  .text { margin-top: 12px; font-size: var(--t-label); line-height: 1.55; color: var(--fg-2); text-wrap: pretty; }
  .faint { color: var(--fg-3); margin-top: 8px; }
  .wordmark {
    position: relative;
    z-index: 1;
    margin-top: clamp(28px, 5vh, 56px);
    margin-bottom: -0.2em;
    text-align: center;
    font-family: var(--f-display);
    font-stretch: 125%;
    font-weight: 200;
    font-size: calc(min(100vw, 1800px) / 10.9);
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    color: transparent;
    background: linear-gradient(to bottom, rgba(243, 235, 222, 0.14), rgba(243, 235, 222, 0.02));
    background-clip: text;
    user-select: none;
    pointer-events: none;
  }
  .wordmark:lang(zh) { letter-spacing: 0.3em; }
  @media (max-width: 760px) {
    .inner { grid-template-columns: 1fr 1fr; }
    .about { grid-column: 1 / -1; }
  }
  @media print { .footer { display: none; } }
</style>
