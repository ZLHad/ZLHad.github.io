---
// The command palette: Cmd/Ctrl-K or "/" from anywhere, to any page, paper or project.
import { getCollection } from 'astro:content';
import Icon from '~/components/chrome/Icon.astro';
import { href, paperHref, pick, ui, type Lang } from '~/lib/i18n';
import { allPapers, authorsOf, titleOf, venueOf } from '~/lib/papers';
import { profile } from '~/data/profile';
interface Props { lang: Lang }
const { lang } = Astro.props;
const zh = lang === 'zh';
const s = ui(lang);
const papers = await allPapers();
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const groups = zh
  ? { page: '页面', paper: '论文', project: '项目', action: '操作' }
  : { page: 'Pages', paper: 'Papers', project: 'Projects', action: 'Actions' };
const items = [
  ...[
    [s.home, '/'],
    [s.publications, '/publications/'],
    [s.research, '/research/'],
    [s.projects, '/projects/'],
    [s.cv, '/cv/'],
  ].map(([t, to]) => ({ g: groups.page, t, h: href(lang, to) })),
  ...papers.map((p) => ({
    g: groups.paper,
    t: titleOf(p, lang),
    s: `${p.data.venueShort} ${p.data.year}`,
    k: `${authorsOf(p, lang).join(' ')} ${venueOf(p, lang)} ${p.data.title}`,
    h: paperHref(lang, p.id),
    p: p.id,
  })),
  ...projects.map((p) => ({
    g: groups.project,
    t: zh && p.data.nameZh ? p.data.nameZh : p.data.name,
    s: pick(p.data.tagline, lang),
    k: p.data.name,
    h: href(lang, `/projects/#${p.id}`),
  })),
  { g: groups.action, t: zh ? '复制邮箱地址' : 'Copy email address', s: profile.email, copy: profile.email },
  { g: groups.action, t: zh ? '下载全部 BibTeX' : 'Download all as BibTeX', s: 'publications.bib', h: '/publications.bib' },
  { g: groups.action, t: 'GitHub', s: 'github.com/ZLHad', h: profile.links.github },
];
---
<dialog id="palette" aria-label={zh ? '搜索' : 'Search'} data-copied={s.copied} data-none={zh ? '没有找到。' : 'Nothing found.'}>
  <div class="pl-box">
    <label class="pl-input">
      <Icon name="search" />
      <input type="text" data-pl-input placeholder={zh ? '搜索论文、作者、期刊、项目…' : 'Search papers, authors, venues, projects…'} autocomplete="off" spellcheck="false" aria-label={zh ? '搜索内容' : 'Search'} />
      <kbd class="key">Esc</kbd>
    </label>
    <ul class="pl-list" data-pl-list role="listbox"></ul>
    <p class="pl-foot">
      <span><kbd class="key">↑</kbd><kbd class="key">↓</kbd> {zh ? '选择' : 'Move'}</span>
      <span><kbd class="key">↵</kbd> {zh ? '打开' : 'Open'}</span>
    </p>
  </div>
</dialog>
<script type="application/json" id="palette-data" set:html={JSON.stringify(items)} />

<style is:global>
  #palette {
    width: min(660px, 94vw);
    max-width: none;
    margin: min(16vh, 140px) auto auto;
    padding: 0;
    border: 0;
    border-radius: var(--r-3);
    background: var(--bg-2);
    box-shadow: inset 0 0 0 1px var(--line), 0 40px 120px -20px rgba(0, 0, 0, 0.85);
    overflow: hidden;
  }
  #palette[open] { animation: pl-in 0.28s var(--ease-out); }
  #palette::backdrop { background: rgba(4, 6, 9, 0.6); backdrop-filter: blur(6px); }
  @keyframes pl-in { from { opacity: 0; transform: translateY(-10px) scale(0.985); } }
  .pl-input { display: flex; align-items: center; gap: 10px; height: 54px; padding: 0 14px 0 16px; color: var(--fg-3); box-shadow: 0 1px 0 var(--line-2); }
  .pl-input input { flex: 1; min-width: 0; height: 100%; font: inherit; font-size: var(--t-body); color: var(--fg); background: none; border: 0; outline: 0; }
  .pl-input input::placeholder { color: var(--fg-3); }
  .pl-list { max-height: min(52vh, 420px); overflow-y: auto; padding: 6px; scroll-padding: 34px 0 6px; overscroll-behavior: contain; }
  .pl-group { padding: 10px 10px 4px; font-family: var(--f-mono); font-size: var(--t-label); color: var(--fg-3); }
  .pl-item { display: flex; align-items: baseline; justify-content: space-between; gap: 18px; padding: 8px 10px; font-size: var(--t-small); line-height: 1.4; color: var(--fg-2); border-radius: var(--r-1); cursor: pointer; }
  .pl-item span:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pl-item span:last-child { flex: none; max-width: 44%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--f-mono); font-size: var(--t-label); color: var(--fg-3); }
  .pl-item.on { color: var(--fg); background: rgba(190, 205, 225, 0.1); }
  .pl-none { padding: 22px 10px; text-align: center; font-size: var(--t-small); color: var(--fg-3); }
  .pl-foot { display: flex; gap: 16px; padding: 8px 14px; font-size: var(--t-label); color: var(--fg-3); box-shadow: 0 -1px 0 var(--line-2); }
  .pl-foot span { display: inline-flex; align-items: center; gap: 4px; }
  .pl-foot .key { height: 20px; min-width: 20px; }
  @media (max-width: 760px) { .pl-foot { display: none; } #palette { margin-top: 12px; } }
</style>
