---
// A stipple portrait that starts as a scatter of points and settles into a face
// when it comes into view. The dots are computed from the photo by scripts/make-portrait.mjs.
interface Props { alt: string }
const { alt } = Astro.props;
---
<figure class="portrait" data-portrait>
  <canvas role="img" aria-label={alt}></canvas>
  <noscript><img src="/media/portrait.webp" alt={alt} width="600" height="842" /></noscript>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-portrait]').forEach(async (root) => {
    const canvas = root.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const res = await fetch('/media/portrait.json');
    const { w, h, p } = (await res.json()) as { w: number; h: number; p: number[] };
    const n = p.length / 3;

    // Scatter seeded per dot, so the settling looks like a constellation resolving.
    const sx = new Float32Array(n);
    const sy = new Float32Array(n);
    const delay = new Float32Array(n);
    let seed = 99;
    const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
    for (let i = 0; i < n; i++) {
      sx[i] = rnd() * w;
      sy[i] = rnd() * h;
      delay[i] = rnd() * 0.35;
    }

    const css = getComputedStyle(root);
    const ink = css.getPropertyValue('--fg').trim() || '#eef1f5';
    let scale = 1;
    const fit = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const cw = root.clientWidth;
      scale = cw / w;
      canvas.width = Math.round(cw * dpr);
      canvas.height = Math.round((cw * h) / w * dpr);
      canvas.style.height = `${(cw * h) / w}px`;
      ctx.setTransform(dpr * scale, 0, 0, dpr * scale, 0, 0);
    };

    const ease = (t: number) => 1 - Math.pow(1 - t, 4);
    const draw = (u: number) => {
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = ink;
      ctx.beginPath();
      for (let i = 0; i < n; i++) {
        const t = ease(Math.min(1, Math.max(0, (u - delay[i]) / (1 - 0.35))));
        const x = sx[i] + (p[i * 3] / 10 - sx[i]) * t;
        const y = sy[i] + (p[i * 3 + 1] / 10 - sy[i]) * t;
        const r = (p[i * 3 + 2] / 100) * (0.55 + 0.45 * t);
        ctx.moveTo(x + r, y);
        ctx.arc(x, y, r, 0, 6.2832);
      }
      ctx.fill();
    };

    // Once settled, the dots part around the pointer and close again behind it.
    let settled = false;
    let mx = -999;
    let my = -999;
    let k = 0;
    let target = 0;
    let hoverFrame = 0;
    const R = 38;
    const drawHover = () => {
      k += (target - k) * 0.14;
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = ink;
      ctx.beginPath();
      for (let i = 0; i < n; i++) {
        let x = p[i * 3] / 10;
        let y = p[i * 3 + 1] / 10;
        const dx = x - mx;
        const dy = y - my;
        const d2 = dx * dx + dy * dy;
        if (d2 < R * R) {
          const d = Math.sqrt(d2) || 1;
          const f = 1 - d / R;
          const push = f * f * 20 * k;
          x += (dx / d) * push;
          y += (dy / d) * push;
        }
        const r = p[i * 3 + 2] / 100;
        ctx.moveTo(x + r, y);
        ctx.arc(x, y, r, 0, 6.2832);
      }
      ctx.fill();
      if (target || k > 0.01) hoverFrame = requestAnimationFrame(drawHover);
      else {
        hoverFrame = 0;
        draw(1);
      }
    };
    if (!reduced && matchMedia('(hover: hover)').matches) {
      root.addEventListener('pointermove', (e) => {
        if (!settled) return;
        const b = canvas.getBoundingClientRect();
        mx = (e.clientX - b.left) / scale;
        my = (e.clientY - b.top) / scale;
        target = 1;
        if (!hoverFrame) hoverFrame = requestAnimationFrame(drawHover);
      });
      root.addEventListener('pointerleave', () => (target = 0));
    }

    fit();
    draw(reduced ? 1 : 0);
    let started = false;
    new ResizeObserver(() => {
      fit();
      if (started || reduced) draw(1);
    }).observe(root);
    new IntersectionObserver(
      ([e], obs) => {
        if (!e.isIntersecting || started) return;
        started = true;
        obs.disconnect();
        if (reduced) return draw(1);
        const t0 = performance.now();
        const step = (now: number) => {
          const u = Math.min(1, (now - t0) / 2400);
          draw(u);
          if (u < 1) requestAnimationFrame(step);
          else settled = true;
        };
        requestAnimationFrame(step);
      },
      { threshold: 0.25 },
    ).observe(root);
  });
</script>

<style>
  .portrait { width: 100%; }
  canvas { width: 100%; display: block; }
  img { width: 100%; height: auto; }
</style>
