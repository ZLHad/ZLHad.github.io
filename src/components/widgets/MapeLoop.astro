---
// The paper's control loop, walked through with the paper's own worked example.
import type { Lang } from '~/lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const zh = lang === 'zh';

const stages = zh
  ? [
      { key: 'monitor', name: '监测', who: '遥测，经由模型上下文协议（MCP）', what: '从卫星、无人机和地面站收集遥测与性能指标，并做归一化。', ex: 'UAV-1 只剩 20% 电量，UAV-2 还有 80%。' },
      { key: 'analyze', name: '分析', who: '语义资源感知器', what: '把测量值、历史记录和检索到的知识融合成一个跨层的语义状态。', ex: '无人机集群能量受限；卫星可以兜底，但时延更高。' },
      { key: 'plan', name: '规划', who: '意图驱动的资源编排器', what: '读懂运维意图，推理后调用工具：强化学习智能体、优化求解器、SDN 接口。它不做快速决策，而是改写快速智能体学习用的奖励，并用扩散模型引导探索。', ex: '意图是“最小化服务时延，同时保证无人机能量可持续”。编排器调用 D3PG，调整奖励以惩罚耗尽电量的无人机分配，鼓励卫星辅助或地面处理。' },
      { key: 'execute', name: '执行', who: '编排器与 SDN 控制器', what: '把方案翻译成网络操作。每个 LLM 输出都要过 JSON schema 和参数范围检查；检查失败时，强化学习智能体退回安全的默认奖励。', ex: '落到具体的 SDN 流表、资源分配和功率控制命令。' },
      { key: 'learn', name: '知识与学习', who: '自适应学习器', what: '盯着 KPI，在指标超出阈值或按周期更新提示词和奖励，每次更新都留下推理记录。知识库存放标准、日志和可复用的工作流模板。', ex: '当观测到的时延超过目标，学习器记下偏差，并为下一轮决策修正奖励配置。' },
    ]
  : [
      { key: 'monitor', name: 'Monitor', who: 'Telemetry, through the Model Context Protocol', what: 'Collects telemetry and performance indicators from satellites, UAVs and ground stations, and normalizes them.', ex: 'UAV-1 is down to 20% energy. UAV-2 still has 80%.' },
      { key: 'analyze', name: 'Analyze', who: 'Semantic resource perceiver', what: 'Fuses measurements, history and retrieved knowledge into one semantic, cross-layer state.', ex: 'The UAV cluster is energy-constrained, while satellite backup remains available at higher latency.' },
      { key: 'plan', name: 'Plan', who: 'Intent-driven resource orchestrator', what: 'Reads the operator’s intent, reasons through it and calls tools: reinforcement-learning agents, solvers, SDN APIs. It makes no fast decision itself. It rewrites the reward the fast agent learns from, and guides its exploration with a diffusion model.', ex: 'The intent is “minimize service latency while ensuring UAV energy sustainability”. The orchestrator invokes D3PG and shapes its reward to penalize energy-depleting UAV assignments and favor satellite-assisted or ground processing.' },
      { key: 'execute', name: 'Execute', who: 'Orchestrator and SDN controllers', what: 'Turns the plan into network operations. Every LLM output is checked against a JSON schema and parameter bounds, and the RL agents fall back to a safe default reward when the check fails.', ex: 'Concrete SDN flow rules, resource allocations and power control commands.' },
      { key: 'learn', name: 'Knowledge', who: 'Adaptive learner and policy refiner', what: 'Watches KPIs and refines prompts and rewards when they drift past a threshold or on a schedule, recording its reasoning each time. The knowledge store holds standards, logs and reusable workflow templates.', ex: 'When observed latency exceeds the target, the learner records the deviation and refines the reward for the next cycle.' },
    ];

const C = 260;
const R = 196;
const polar = (deg: number, r = R) => {
  const a = (deg * Math.PI) / 180;
  return [C + r * Math.cos(a), C + r * Math.sin(a)];
};
const arc = (a0: number, a1: number) => {
  const [x0, y0] = polar(a0);
  const [x1, y1] = polar(a1);
  return `M${x0.toFixed(1)} ${y0.toFixed(1)}A${R} ${R} 0 0 1 ${x1.toFixed(1)} ${y1.toFixed(1)}`;
};
// Clockwise from the left, like the paper's Fig. 2: Monitor, Analyze, Plan, Execute.
const arcs = [
  { key: 'monitor', a0: 137, a1: 223, label: 180 },
  { key: 'analyze', a0: 227, a1: 313, label: 270 },
  { key: 'plan', a0: 317, a1: 403, label: 0 },
  { key: 'execute', a0: 47, a1: 133, label: 90 },
];
const labels = {
  slow: zh ? 'LLM 智能体 · 秒级' : 'LLM agents · seconds',
  fast: zh ? 'RL 智能体 · 毫秒级' : 'RL agent · milliseconds',
  who: zh ? '谁来做' : 'Who',
  ex: zh ? '论文里的例子' : 'In the paper’s worked example',
};
---
<figure class="mape card" data-mape>
  <div class="ring">
    <svg viewBox="0 0 520 520" role="img" aria-label={zh ? 'MAPE-K 控制回路' : 'The MAPE-K control loop'}>
      <defs>
        <marker id="mape-head" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 0 8 4 0 8" fill="none" stroke="currentColor" stroke-width="1" />
        </marker>
      </defs>
      <circle cx={C} cy={C} r="244" class="orbit" />
      <path id="mape-slow-path" d={`M${C - 244} ${C}a244 244 0 1 1 488 0a244 244 0 1 1 -488 0`} fill="none" />
      <text class="ring-label"><textPath href="#mape-slow-path" startOffset="4.5%">{labels.slow}</textPath></text>
      <circle r="3" class="pulse slow">
        <animateMotion dur="14s" repeatCount="indefinite" path={`M${C - 244} ${C}a244 244 0 1 1 488 0a244 244 0 1 1 -488 0`} />
      </circle>

      {arcs.map((a) => (
        <g class="stage" data-stage={a.key} tabindex="-1">
          <path d={arc(a.a0, a.a1)} class="arc" marker-end="url(#mape-head)" />
          <path d={arc(a.a0, a.a1)} class="hit" />
          <text
            x={polar(a.label, R - (a.label === 0 || a.label === 180 ? 18 : 24))[0]}
            y={polar(a.label, R - (a.label === 0 || a.label === 180 ? 18 : 24))[1]}
            text-anchor={a.label === 0 ? 'end' : a.label === 180 ? 'start' : 'middle'}
            dominant-baseline="middle"
            class="stage-name"
          >
            {stages.find((s) => s.key === a.key)!.name}
          </text>
        </g>
      ))}

      <!-- The fast loop sits inside Plan: the LLM shapes it, it never replaces it. -->
      <g transform={`translate(${C + 92} ${C - 2})`}>
        <circle r="24" class="fast" />
        <circle r="2.4" class="pulse fast-dot">
          <animateMotion dur="0.9s" repeatCount="indefinite" path="M-24 0a24 24 0 1 1 48 0a24 24 0 1 1 -48 0" />
        </circle>
        <text y="46" text-anchor="middle" class="ring-label small">{labels.fast}</text>
      </g>

      <g class="stage center" data-stage="learn" tabindex="-1">
        <circle cx={C - 40} cy={C} r="58" class="core" />
        <text x={C - 40} y={C} text-anchor="middle" dominant-baseline="middle" class="stage-name">
          {stages.find((s) => s.key === 'learn')!.name}
        </text>
      </g>
    </svg>
  </div>

  <div class="panel">
    <div class="tabs" role="tablist">
      {stages.map((s, i) => (
        <button type="button" role="tab" data-tab={s.key} aria-selected={i === 0 ? 'true' : 'false'}>{s.name}</button>
      ))}
    </div>
    {stages.map((s, i) => (
      <div class="pane" data-pane={s.key} role="tabpanel" hidden={i !== 0}>
        <p class="label">{labels.who}</p>
        <p class="who">{s.who}</p>
        <p class="what">{s.what}</p>
        <p class="label ex-label">{labels.ex}</p>
        <p class="ex">{s.ex}</p>
      </div>
    ))}
  </div>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-mape]').forEach((root) => {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panes = [...root.querySelectorAll<HTMLElement>('[data-pane]')];
    const gs = [...root.querySelectorAll<SVGGElement>('[data-stage]')];
    const order = tabs.map((t) => t.dataset.tab!);
    let auto = !reduced;
    let current = 0;

    const select = (key: string) => {
      current = order.indexOf(key);
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === key)));
      panes.forEach((p) => (p.hidden = p.dataset.pane !== key));
      gs.forEach((g) => g.classList.toggle('on', g.dataset.stage === key));
    };
    const choose = (key: string) => {
      auto = false;
      select(key);
    };
    tabs.forEach((t) => t.addEventListener('click', () => choose(t.dataset.tab!)));
    gs.forEach((g) => g.addEventListener('click', () => choose(g.dataset.stage!)));
    select(order[0]);

    let visible = false;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.4 }).observe(root);
    setInterval(() => {
      if (auto && visible && !document.hidden) select(order[(current + 1) % order.length]);
    }, 6500);
  });
</script>

<style>
  .mape {
    display: grid;
    grid-template-columns: minmax(0, 460px) minmax(0, 1fr);
    gap: clamp(20px, 4vw, 56px);
    align-items: center;
    padding: clamp(16px, 2.4vw, 32px);
  }
  svg { width: 100%; height: auto; overflow: visible; color: var(--fg); }
  .orbit { fill: none; stroke: var(--line); stroke-dasharray: 1 5; }
  .ring-label { font-family: var(--f-sans); font-size: 16px; font-weight: 450; fill: var(--fg-3); }
  .ring-label.small { font-size: 15px; }
  .pulse { fill: var(--signal); filter: drop-shadow(0 0 4px rgba(255, 122, 61, 0.9)); }
  .fast { fill: none; stroke: var(--fg-3); stroke-dasharray: 2 3; }
  .arc { fill: none; stroke: var(--fg-3); stroke-width: 1; transition: stroke var(--d-3), stroke-width var(--d-3); }
  .hit { fill: none; stroke: transparent; stroke-width: 44; cursor: pointer; }
  .stage { cursor: pointer; outline: none; }
  .stage-name { font-family: var(--f-sans); font-weight: 500; font-size: 21px; fill: var(--fg-2); transition: fill var(--d-3); }
  .core { fill: rgba(190, 205, 225, 0.03); stroke: var(--fg-3); transition: stroke var(--d-3), fill var(--d-3); }
  .center .stage-name { font-size: 16px; }
  .stage:hover .stage-name { fill: var(--fg); }
  .stage.on .arc { stroke: var(--signal); stroke-width: 2; filter: drop-shadow(0 0 6px rgba(255, 122, 61, 0.55)); }
  .stage.on .core { stroke: var(--signal); fill: var(--signal-wash); }
  .stage.on .stage-name { fill: var(--fg); }
  .tabs { display: flex; flex-wrap: wrap; gap: 2px; padding: 3px; border-radius: 10px; width: fit-content; background: rgba(190, 205, 225, 0.05); box-shadow: inset 0 0 0 1px var(--line-2); }
  .tabs button { height: 28px; padding: 0 10px; font-size: var(--t-small); font-weight: 500; color: var(--fg-3); border-radius: 7px; transition: color var(--d-1), background var(--d-1); }
  .tabs button:hover { color: var(--fg); }
  .tabs button[aria-selected='true'] { color: var(--fg); background: rgba(190, 205, 225, 0.13); }
  .pane { padding-top: 18px; min-height: 20em; animation: pane-in 0.46s var(--ease-out); }
  .pane[hidden] { display: none; }
  @keyframes pane-in { from { opacity: 0; transform: translateY(6px); } }
  .who { font-size: var(--t-body); font-weight: 500; margin-top: 4px; }
  .what { margin-top: 12px; font-size: var(--t-text); color: var(--fg-2); }
  .ex-label { margin-top: 20px; }
  .ex { margin-top: 6px; font-size: var(--t-body); line-height: 1.45; letter-spacing: -0.008em; }
  @media (max-width: 899px) {
    .mape { grid-template-columns: minmax(0, 1fr); }
    .pane { min-height: 0; }
    .ring-label { font-size: 21.6px; }
    .ring-label.small { font-size: 21.6px; }
    .stage-name { font-size: 26px; }
    .center .stage-name { font-size: 21.6px; }
  }
</style>
