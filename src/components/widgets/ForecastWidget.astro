---
// Slide the forecast horizon and watch what a UAV gets to see. The series is an
// illustrative log-AR(4) Gamma stream with the constants from the paper's prediction
// experiment; the whiskers use the Gamma-GLM NRMSE from the paper's Table II.
import nrmse from '~/data/charts/tvt-nrmse.json';
import type { Lang } from '~/lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const zh = lang === 'zh';
const glm = nrmse.series.find((s) => s.name === 'Gamma-GLM')!.values.map((v) => Number(v.toFixed(3)));
const t = zh
  ? {
      h: '预测窗口 H',
      now: '此刻',
      past: '已观测的任务量',
      fut: '预测',
      obs: '一架无人机在 t 时刻的观测（每个感知到的用户）',
      own: '位置、速度、电量',
      cur: '位置、任务量、复杂度',
      fc: '预测任务量',
      again: '换一条序列',
      note: '示意数据：用论文预测实验的常数（log-AR(4)，Gamma 分布）生成的合成序列，误差棒取论文表 II 中 Gamma-GLM 的 NRMSE。它演示的是预测怎样进入观测，不复现论文的时延结果。',
    }
  : {
      h: 'Forecast horizon H',
      now: 'now',
      past: 'Observed task sizes',
      fut: 'Forecast',
      obs: 'What one UAV observes at time t, per sensed user',
      own: 'position, velocity, energy',
      cur: 'location, task size, complexity',
      fc: 'forecast task sizes',
      again: 'New series',
      note: 'Illustrative data: a synthetic series from the constants of the paper’s prediction experiment (log-AR(4), Gamma-distributed), with whiskers from the Gamma-GLM NRMSE in the paper’s Table II. It shows how a forecast enters the observation. It does not reproduce the paper’s delay results.',
    };
---
<figure class="fc card" data-forecast data-nrmse={JSON.stringify(glm)} data-labels={JSON.stringify({ now: t.now })}>
  <div class="top">
    <label class="ctl">
      <span class="label">{t.h} = <output data-h-out>3</output></span>
      <input type="range" min="0" max="6" step="1" value="3" data-h />
    </label>
    <button type="button" class="btn small" data-new>{t.again}</button>
  </div>
  <svg data-plot viewBox="0 0 720 200" preserveAspectRatio="none" aria-hidden="true"></svg>
  <div class="legend label"><span>{t.past}</span><span class="f">{t.fut}</span></div>
  <div class="obs">
    <p class="label">{t.obs}</p>
    <div class="vec">
      <span class="cell a">{t.own}</span>
      <span class="cell b">{t.cur}</span>
      <span class="fcs" data-cells></span>
    </div>
    <p class="label vec-note" data-fc-note>{t.fc}</p>
  </div>
  <p class="note">{t.note}</p>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-forecast]').forEach((root) => {
    const nrmse = JSON.parse(root.dataset.nrmse!) as number[];
    const labels = JSON.parse(root.dataset.labels!) as { now: string };
    const svg = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const slider = root.querySelector<HTMLInputElement>('[data-h]')!;
    const out = root.querySelector<HTMLElement>('[data-h-out]')!;
    const cells = root.querySelector<HTMLElement>('[data-cells]')!;

    // Constants from the paper's prediction_experiment.py.
    const PHI = [0.45, 0.18, 0.08, 0.04];
    const NOISE = 0.15;
    const MU = -0.03;
    const PAST = 30;
    let seed = 7;
    const rand = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
    const gauss = () => Math.sqrt(-2 * Math.log(rand() + 1e-9)) * Math.cos(2 * Math.PI * rand());

    let logs: number[] = [];
    const generate = () => {
      logs = [MU, MU, MU, MU];
      for (let i = 0; i < PAST + 60; i++) {
        let x = MU;
        for (let k = 0; k < 4; k++) x += PHI[k] * (logs[logs.length - 1 - k] - MU);
        logs.push(x + gauss() * NOISE);
      }
      logs = logs.slice(-PAST);
    };
    const forecast = (H: number) => {
      const buf = logs.slice();
      const res: number[] = [];
      for (let h = 0; h < H; h++) {
        let x = MU;
        for (let k = 0; k < 4; k++) x += PHI[k] * (buf[buf.length - 1 - k] - MU);
        buf.push(x);
        res.push(Math.exp(x));
      }
      return res;
    };

    const draw = () => {
      const H = Number(slider.value);
      out.textContent = String(H);
      const W = 720;
      const base = 176;
      const slots = PAST + 6;
      const bw = W / slots;
      const y = (v: number) => base - (v / 2.1) * 150;
      const past = logs.map(Math.exp);
      const fut = forecast(H);
      let html = `<line x1="0" x2="${W}" y1="${base}" y2="${base}" stroke="currentColor" stroke-opacity=".6" vector-effect="non-scaling-stroke"/>`;
      past.forEach((v, i) => {
        html += `<rect x="${(i * bw + 1.2).toFixed(1)}" y="${y(v).toFixed(1)}" width="${(bw - 2.4).toFixed(1)}" height="${(base - y(v)).toFixed(1)}" fill="currentColor" fill-opacity=".62"/>`;
      });
      const nowX = PAST * bw;
      html += `<line x1="${nowX}" x2="${nowX}" y1="6" y2="${base + 6}" stroke="var(--signal)" vector-effect="non-scaling-stroke"/>`;
      fut.forEach((v, i) => {
        const x = (PAST + i) * bw + 1.2;
        const err = nrmse[i] * v;
        html += `<rect x="${x.toFixed(1)}" y="${y(v).toFixed(1)}" width="${(bw - 2.4).toFixed(1)}" height="${(base - y(v)).toFixed(1)}" fill="none" stroke="var(--signal)" vector-effect="non-scaling-stroke"/>`;
        const cx = x + (bw - 2.4) / 2;
        html += `<line x1="${cx.toFixed(1)}" x2="${cx.toFixed(1)}" y1="${y(v + err).toFixed(1)}" y2="${y(v - err).toFixed(1)}" stroke="var(--signal)" vector-effect="non-scaling-stroke"/>`;
      });
      svg.innerHTML = html;
      cells.innerHTML = Array.from({ length: H }, (_, i) => `<span class="cell c">D̂<sup>(${i + 1})</sup></span>`).join('');
    };

    slider.addEventListener('input', draw);
    root.querySelector('[data-new]')!.addEventListener('click', () => {
      generate();
      draw();
    });
    generate();
    draw();
    void labels;
  });
</script>

<style>
  .fc { padding: clamp(16px, 2.2vw, 26px); }
  .top { display: flex; justify-content: space-between; align-items: end; gap: 20px; }
  .ctl { flex: 1; max-width: 360px; display: flex; flex-direction: column; gap: 6px; }
  output { font-family: var(--f-mono); color: var(--signal-2); }
  svg { width: 100%; height: 170px; margin-top: 12px; color: var(--fg-3); }
  .legend { display: flex; gap: 20px; margin-top: 6px; }
  .legend .f { color: var(--signal-2); }
  .obs { margin-top: 20px; padding-top: 14px; box-shadow: 0 -1px 0 var(--line-2); }
  .vec { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 8px; font-family: var(--f-mono); font-size: var(--t-label); letter-spacing: -0.02em; }
  .vec :global(.cell) { padding: 5px 9px; white-space: nowrap; color: var(--fg-2); border-radius: 6px; box-shadow: inset 0 0 0 1px var(--line); }
  .fcs { display: contents; }
  .fcs :global(.cell.c) { color: var(--signal-2); background: var(--signal-wash); box-shadow: inset 0 0 0 1px rgba(255, 122, 61, 0.4); }
  .fcs :global(sup) { font-size: 0.75em; line-height: 0; }
  .vec-note { margin-top: 8px; color: var(--signal-2); }
  .note { margin-top: 14px; padding-top: 12px; font-size: var(--t-label); line-height: 1.55; color: var(--fg-3); box-shadow: 0 -1px 0 var(--line-2); }
</style>
