---
// The paper's division of labour by timescale: a slow loop that reads the network and
// shapes the reward, wrapped around a fast loop that keeps deciding. Stage names follow
// the paper's Fig. 2, clockwise from the left.
import type { Lang } from '~/lib/i18n';
interface Props { lang: Lang }
const zh = Astro.props.lang === 'zh';
const C = 230;
const R = 186;
const r = 74;
const circ = (radius: number) => 2 * Math.PI * radius;
const t = zh
  ? { slow: '大模型智能体 · 秒级', fast: ['强化学习智能体', '毫秒级'], arrow: ['奖励塑形'], stages: ['监测', '分析', '规划', '执行'], aria: '一个按秒运行的慢回路，包着一个按毫秒运行的快回路' }
  : { slow: 'LLM agents · seconds', fast: ['RL agent', 'milliseconds'], arrow: ['reward', 'shaping'], stages: ['Monitor', 'Analyze', 'Plan', 'Execute'], aria: 'A slow loop running over seconds, wrapped around a fast loop running in milliseconds' };
---
<figure class="loops" data-reveal>
  <svg viewBox="0 0 460 480" role="img" aria-label={t.aria}>
    <defs>
      <marker id="loops-head" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 8 4 0 8" class="arrow-head" />
      </marker>
    </defs>
    <g transform="translate(0 20)">
      <text x={C} y="-4" text-anchor="middle" class="label strong">{t.slow}</text>
      <circle cx={C} cy={C} r={R} class="ring" />
      <circle cx={C} cy={C} r={R} class="run slow" style={`stroke-dasharray:${(circ(R) * 0.16).toFixed(1)} ${(circ(R) * 0.84).toFixed(1)}`} />
      {[0, 90, 180, 270].map((a) => (
        <line x1={C} y1={C - R - 5} x2={C} y2={C - R + 5} transform={`rotate(${a} ${C} ${C})`} class="tick" />
      ))}
      <text x={C - R + 16} y={C + 5} class="label">{t.stages[0]}</text>
      <text x={C} y={C - R + 26} text-anchor="middle" class="label">{t.stages[1]}</text>
      <text x={C + R - 16} y={C - 16} text-anchor="end" class="label">{t.stages[2]}</text>
      <text x={C} y={C + R - 16} text-anchor="middle" class="label">{t.stages[3]}</text>

      <path d={`M${C + R - 8} ${C}H${C + r + 8}`} class="arrow" marker-end="url(#loops-head)" />
      {t.arrow.map((l, i) => <text x={C + (R + r) / 2} y={C + 22 + i * 17} text-anchor="middle" class="label signal">{l}</text>)}

      <circle cx={C} cy={C} r={r} class="ring" />
      <circle cx={C} cy={C} r={r} class="run fast" style={`stroke-dasharray:${(circ(r) * 0.26).toFixed(1)} ${(circ(r) * 0.74).toFixed(1)}`} />
      <text x={C} y={C - 3} text-anchor="middle" class="label strong">{t.fast[0]}</text>
      <text x={C} y={C + 16} text-anchor="middle" class="label">{t.fast[1]}</text>
    </g>
  </svg>
</figure>

<style>
  .loops { width: 100%; max-width: 480px; margin-inline: auto; }
  svg { width: 100%; height: auto; overflow: visible; }
  .ring { fill: none; stroke: var(--line-3); stroke-width: 1; }
  .tick { stroke: var(--fg-2); stroke-width: 1; }
  .run { fill: none; stroke-linecap: round; transform-box: fill-box; transform-origin: center; animation: spin linear infinite; }
  .slow { stroke: var(--signal); stroke-width: 2; animation-duration: 16s; filter: drop-shadow(0 0 6px rgba(255, 122, 61, 0.7)); }
  .fast { stroke: var(--fg); stroke-width: 2; animation-duration: 1.1s; }
  .arrow { fill: none; stroke: var(--signal); stroke-width: 1.25; stroke-dasharray: 3 4; }
  .arrow-head { fill: none; stroke: var(--signal); stroke-width: 1.25; }
  text { font-family: var(--f-sans); font-size: 14px; font-weight: 450; }
  .label { fill: var(--fg-2); }
  .label.strong { fill: var(--fg); font-weight: 500; }
  .label.signal { fill: var(--signal-2); }
  @keyframes spin { to { transform: rotate(360deg); } }
  :global(.stop.off) .run { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) { .run { animation: none; } }
  /* Sizes are in viewBox units; each step holds about 13px on screen at that width. */
  @media (max-width: 560px) { text { font-size: 18px; } }
</style>
